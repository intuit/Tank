{
  "instant": {
    "epochSecond": {
      "$resolver": "timestamp",
      "epoch": {
        "unit": "secs",
        "rounded": true
      }
    },
    "nanoOfSecond": {
      "$resolver": "timestamp",
      "epoch": {
        "unit": "secs.nanos"
      }
    }
  },
  "thread": {
    "$resolver": "thread",
    "field": "name"
  },
  "level": {
    "$resolver": "level",
    "field": "name"
  },
  "loggerName": {
    "$resolver": "logger",
    "field": "name"
  },
  "message": {
    "$resolver": "message"
  },
  "thrown": {
    "message": {
      "$resolver": "exception",
      "field": "message"
    },
    "name": {
      "$resolver": "exception",
      "field": "className"
    },
    "extendedStackTrace": {
      "$resolver": "exception",
      "field": "stackTrace"
    }
  },
  "endOfBatch": {
    "$resolver": "endOfBatch"
  },
  "loggerFqcn": {
    "$resolver": "logger",
    "field": "fqcn"
  },
  "threadId": {
    "$resolver": "thread",
    "field": "id"
  },
  "threadPriority": {
    "$resolver": "thread",
    "field": "priority"
  },
  "timestamp": {
    "$resolver": "timestamp",
    "pattern": {
      "format": "yyyy-MM-dd'T'HH:mm:ss.SSSZ"
    }
  },
  "jobId": {
    "$resolver": "pattern",
    "pattern": "${ctx:jobId:-unknown}"
  },
  "projectName": {
    "$resolver": "pattern",
    "pattern": "${ctx:projectName:-unknown}"
  },
  "instanceId": {
    "$resolver": "pattern",
    "pattern": "${ctx:instanceId:-unknown}"
  },
  "publicIp": {
    "$resolver": "pattern",
    "pattern": "${ctx:publicIp:-unknown}"
  },
  "location": {
    "$resolver": "pattern",
    "pattern": "${ctx:location:-unknown}"
  },
  "httpHost": {
    "$resolver": "pattern",
    "pattern": "${ctx:httpHost:-unknown}"
  },
  "loggingProfile": {
    "$resolver": "pattern",
    "pattern": "${ctx:loggingProfile:-unknown}"
  },
  "workloadType": {
    "$resolver": "pattern",
    "pattern": "${ctx:workloadType:-unknown}"
  },
  "env": {
    "$resolver": "pattern",
    "pattern": "${ctx:env:-unknown}"
  },
  "useEips": {
    "$resolver": "pattern",
    "pattern": "${ctx:useEips:-unknown}"
  },
  "terminationPolicy": {
    "$resolver": "pattern",
    "pattern": "${ctx:terminationPolicy:-unknown}"
  },
  "stopBehavior": {
    "$resolver": "pattern",
    "pattern": "${ctx:stopBehavior:-unknown}"
  }
}
