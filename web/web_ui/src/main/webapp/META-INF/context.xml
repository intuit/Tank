<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- SameSite=Lax keeps the session cookie off cross-site sub-requests (CSRF defence for /v2 REST) -->
    <CookieProcessor className="org.apache.tomcat.util.http.Rfc6265CookieProcessor" sameSiteCookies="lax" />
    <Resource 
        name="BeanManager"
        auth="Container"
        type="jakarta.enterprise.inject.spi.BeanManager"
        factory="org.jboss.weld.resources.ManagerObjectFactory" />
    <Resource name="jdbc/watsDS"
              auth="Container"
              type="javax.sql.DataSource"
              factory="org.apache.tomcat.jdbc.pool.DataSourceFactory"
              maxWait="10000"
              username="root"  password=""
              testOnBorrow="true"
              validationQuery="SELECT 1"
              removeAbandonedOnBorrow="true"
              removeAbandonedOnMaintenance="true"
              removeAbandonedTimeout="60"
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/tank?serverTimezone=UTC"/>
</Context>

